<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Polizas.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- APRENDIZAJE: desde .NET 9 el OpenAPI es nativo (ya no se usa Swashbuckle por defecto). -->
